# Query Thanos Querier (openshift-monitoring) for Limitador usage metrics.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: litemaas-maas-monitoring-view-${NAMESPACE}
  labels:
    app.kubernetes.io/part-of: litemaas
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cluster-monitoring-view
subjects:
  - kind: ServiceAccount
    name: litemaas-backend
    namespace: ${NAMESPACE}
