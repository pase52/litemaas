# Dedicated ServiceAccount for the backend: the MaaS integration uses its token to manage
# MaaSAuthPolicy / MaaSSubscription objects and to query Thanos Querier.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: litemaas-backend
  namespace: ${NAMESPACE}
  labels:
    app: backend
    app.kubernetes.io/part-of: litemaas
